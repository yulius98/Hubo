APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (produksi/dev)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_hubo
DB_USERNAME=postgres
DB_PASSWORD=

# Alternatif SQLite (test lokal ringan)
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_HOST=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting (E2 — real-time notifikasi via Pusher). BROADCAST_CONNECTION=pusher
BROADCAST_CONNECTION=log
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap1

FILESYSTEM_DISK=local
# Queue worker: sync = langsung (dev), database/redis = antrian berat (E4)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URL="${APP_URL}/authenticate"

# Payment gateway & ongkir: kredensial diisi dari panel admin (tersimpan di DB),
# hanya endpoint/base URL yang bisa dioverride lewat env ini.
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
XENDIT_BASE_URL=https://api.xendit.co
MIDTRANS_SANDBOX_BASE_URL=https://app.sandbox.midtrans.com/api/v2
MIDTRANS_PRODUCTION_BASE_URL=https://app.midtrans.com/api/v2

# Parameter bisnis ongkir (dipakai frontend & backend checkout)
SHIPPING_UNIT_WEIGHT_GRAM=500
SHIPPING_DEFAULT_CITY_ID=152

# Backup database (command otomatis)
BACKUP_RETENTION_DAYS=7
# SQLITE_BACKUP_BIN=sqlite3

# Tunnel lokal (opsional, hanya untuk dev)
# CLOUDFLARE_TUNNEL_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
